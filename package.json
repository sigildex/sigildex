{
  "name": "sigildex",
  "version": "0.1.0",
  "description": "Approval and drift toolkit for AI agent skills — record exactly what was reviewed, detect when it changes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sigildex": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "docs",
    "schema",
    "skills",
    "llms.txt",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigildex/sigildex.git"
  },
  "homepage": "https://github.com/sigildex/sigildex",
  "bugs": {
    "url": "https://github.com/sigildex/sigildex/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "verify:example": "node examples/version-drift/verify-example.mjs"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
